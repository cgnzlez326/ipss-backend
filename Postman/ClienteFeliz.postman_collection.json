    {
      "name": "Postulaciones",
      "description": "CRUD de postulaciones. Postular: solo candidato (el candidato_id se toma del usuario autenticado). Ver: el candidato solo las suyas, el reclutador todas o por oferta. Cambiar estado/eliminar: solo reclutador (el reclutador_id se toma del usuario autenticado).",
      "item": [
        {
          "name": "Crear postulacion",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"oferta_id\": 1\n}"
            },
            "url": {
              "raw": "{{base_url}}/postulaciones",
              "host": ["{{base_url}}"],
              "path": ["postulaciones"]
            },
            "description": "El candidato se postula a una oferta. Rol requerido: candidato. El candidato_id se obtiene del usuario autenticado (el creado en Setup), no se envia en el body. Estado inicial: Postulando. Si ya se postulo a esa oferta: 409 Conflict.",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{user_candidato}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{pass_candidato}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [
            {
              "name": "201 Created",
              "originalRequest": {
                "method": "POST",
                "header": [],
                "body": {
                  "mode": "raw",
                  "raw": "{\n    \"oferta_id\": 1\n}"
                },
                "url": {
                  "raw": "{{base_url}}/postulaciones",
                  "host": ["{{base_url}}"],
                  "path": ["postulaciones"]
                }
              },
              "status": "Created",
              "code": 201,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json; charset=utf-8"
                }
              ],
              "body": "{\n    \"success\": true,\n    \"data\": {\n        \"id\": 1,\n        \"estado\": \"Postulando\"\n    }\n}"
            },
            {
              "name": "409 Conflict",
              "originalRequest": {
                "method": "POST",
                "header": [],
                "body": {
                  "mode": "raw",
                  "raw": "{\n    \"oferta_id\": 1\n}"
                },
                "url": {
                  "raw": "{{base_url}}/postulaciones",
                  "host": ["{{base_url}}"],
                  "path": ["postulaciones"]
                }
              },
              "status": "Conflict",
              "code": 409,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json; charset=utf-8"
                }
              ],
              "body": "{\n    \"success\": false,\n    \"message\": \"El candidato ya se postulo a esta oferta.\"\n}"
            }
          ]
        },
