    {
      "name": "Usuarios",
      "description": "CRUD de usuarios. La creacion de candidatos esta en el folder Setup. Listar/eliminar usuarios: solo reclutador. Ver/editar perfil: cualquier autenticado (el candidato solo el suyo, usando {{candidato_id}}).",
      "item": [
        {
          "name": "Listar usuarios",
          "request": {
            "method": "GET",
            "header": [],
